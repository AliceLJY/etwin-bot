# etwin-bot AGY 实例 env 模板

TG_BOT_TOKEN=
ALICE_CHAT_ID=

ETWIN_INSTANCE=agy
ETWIN_DISPLAY_NAME="etwin-agy"
ETWIN_PERSONA=agy
ETWIN_REPLY_PROMPT=prompts/reply-agy.md
ETWIN_LLM_BACKEND=agy
# 默认沿用 AGY 自己的模型设置；需要固定时再取消下面两行注释
# ETWIN_AGY_MODEL=gemini-3.1-pro-high
# ETWIN_AGY_EFFORT=high
# AGY CLI soft timeout；Node 外层 hard timeout 为此值加 60 秒
ETWIN_AGY_TIMEOUT_MS=600000
ETWIN_TOOL_MODE=auto
ETWIN_TYPING_KEEPALIVE_MS=4500
ETWIN_REACTIVE_HISTORY_LIMIT=16
ETWIN_REACTIVE_STALL_NOTICE_MS=120000

# AGY 文本后端暂不接管图片文件输出；显式图片请求继续走现有 Gemini web image 路径
ETWIN_IMAGE_PROVIDER=gemini
ETWIN_IMAGE_TIMEOUT_MS=600000

ETWIN_DATA_DIR=data-agy
ETWIN_FILE_DIR=files-agy
ETWIN_RECALL_SCOPE=etwin:agy

ETWIN_DRY_RUN=false
ETWIN_PROACTIVE=true
ETWIN_RUN_ON_START=false
ETWIN_WAKE_INTERVAL_MS=14400000
ETWIN_SELF_PROMPT=prompts/self-decision-agy.md
